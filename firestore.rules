rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny fallback
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity validation helpers
    function isValidUser(data, userId) {
      return data.keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
             data.userId == userId &&
             data.email is string && data.email.size() > 3 && data.email.size() <= 200 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    function isValidWatchlistItem(data) {
      return data.keys().hasAll(['assetId', 'symbol', 'category', 'createdAt']) &&
             data.keys().hasOnly(['assetId', 'symbol', 'category', 'createdAt']) &&
             data.assetId is string && data.assetId.size() > 0 && data.assetId.size() <= 64 &&
             data.symbol is string && data.symbol.size() > 0 && data.symbol.size() <= 32 &&
             data.category in ['crypto', 'forex', 'commodities'];
    }

    function isValidSavedAnalysis(data) {
      return data.keys().hasAll(['headline', 'sentiment', 'arabicAnalysis', 'relatedAsset', 'createdAt']) &&
             data.keys().hasOnly(['headline', 'sentiment', 'arabicAnalysis', 'probabilityShift', 'relatedAsset', 'createdAt']) &&
             data.headline is string && data.headline.size() > 0 && data.headline.size() <= 300 &&
             data.sentiment in ['BULLISH', 'BEARISH', 'NEUTRAL'] &&
             data.arabicAnalysis is string && data.arabicAnalysis.size() > 0 && data.arabicAnalysis.size() <= 1000 &&
             data.relatedAsset is string && data.relatedAsset.size() > 0 && data.relatedAsset.size() <= 32 &&
             (!('probabilityShift' in data) || (data.probabilityShift is number));
    }

    function isValidTradeSetup(data) {
      return data.keys().hasAll(['symbol', 'entryPrice', 'stopLossPrice', 'takeProfitPrice', 'lotSize', 'dollarRisk', 'riskRewardRatio', 'createdAt']) &&
             data.keys().hasOnly(['symbol', 'entryPrice', 'stopLossPrice', 'takeProfitPrice', 'lotSize', 'dollarRisk', 'riskRewardRatio', 'createdAt']) &&
             data.symbol is string && data.symbol.size() > 0 && data.symbol.size() <= 32 &&
             data.entryPrice is number && data.entryPrice > 0 &&
             data.stopLossPrice is number && data.stopLossPrice > 0 &&
             data.takeProfitPrice is number && data.takeProfitPrice > 0 &&
             data.lotSize is number && data.lotSize > 0 &&
             data.dollarRisk is number && data.dollarRisk >= 0 &&
             data.riskRewardRatio is number && data.riskRewardRatio >= 0;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming(), userId) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidUser(incoming(), userId) && incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt && incoming().userId == existing().userId;
      allow delete: if false;

      // Pinned Watchlist subcollection
      match /watchlist/{assetId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(assetId) && isValidWatchlistItem(incoming()) && incoming().createdAt == request.time;
        allow delete: if isOwner(userId) && isValidId(assetId);
      }

      // Saved AI Market Analyses subcollection
      match /savedAnalyses/{analysisId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(analysisId) && isValidSavedAnalysis(incoming()) && incoming().createdAt == request.time;
        allow delete: if isOwner(userId) && isValidId(analysisId);
      }

      // Recorded Trade Setups & Risk Calculations subcollection
      match /tradeSetups/{setupId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(setupId) && isValidTradeSetup(incoming()) && incoming().createdAt == request.time;
        allow delete: if isOwner(userId) && isValidId(setupId);
      }
    }
  }
}
